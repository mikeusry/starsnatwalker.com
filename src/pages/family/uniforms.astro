---
import FamilyChrome from '../../components/FamilyChrome.astro';
---

<FamilyChrome title="Uniforms" current="uniforms">
  <div class="space-y-5">
    <section class="bg-stars-navy text-white rounded-xl p-5 shadow-md">
      <p class="text-xs font-semibold uppercase tracking-wider text-stars-gold">The call</p>
      <h1 class="text-xl font-semibold mt-1">We added white pinstripes</h1>
      <p class="text-white/80 text-sm mt-2">Order them if you don’t have them yet. Graduation year on the right sleeve.</p>
      <ul class="mt-3 text-sm space-y-1">
        <li><span class="font-mono text-stars-gold">EMU053534-B</span> — Navy pinstripe cooling</li>
        <li><span class="font-mono text-stars-gold">EMU056821-B</span> — White pinstripe cooling</li>
      </ul>
    </section>

    <section class="grid grid-cols-2 gap-4">
      <figure class="bg-white rounded-xl shadow-md p-3">
        <img src="/family/uniforms/navy-pinstripe.png" alt="Navy pinstripe Stars National jersey" class="w-full rounded-lg" />
        <figcaption class="text-sm text-gray-600 mt-2">Navy pinstripe</figcaption>
      </figure>
      <figure class="bg-white rounded-xl shadow-md p-3">
        <img src="/family/uniforms/white-pinstripe.png" alt="White pinstripe Stars National jersey" class="w-full rounded-lg" />
        <figcaption class="text-sm text-gray-600 mt-2">White pinstripe</figcaption>
      </figure>
    </section>

    <section class="bg-white rounded-xl shadow-md p-5 text-sm text-gray-700 space-y-2">
      <h2 class="text-stars-navy font-semibold">The rest of the kit</h2>
      <p class="text-gray-500">Adrian’s packet, Aug 5.</p>
      <p><span class="text-stars-navy font-medium">Cooling jerseys.</span> Navy EMU072680-C-bl · White EMU072680-A-bl</p>
      <p><span class="text-stars-navy font-medium">Pants.</span> Navy with white stripe · White with blue piping · Navy or white pinstripe knickers</p>
      <p><span class="text-stars-navy font-medium">Socks / belt.</span> Navy or white performance socks · Pro-SRZ striped · Next Gen belt, navy or grey</p>
      <p><span class="text-stars-navy font-medium">Cold / bag / helmet.</span> Pro Team Heater · Tone Set Backpack · Custom XVT Helmet 2.0 with facemask</p>
      <a href="/family/2026-fall-uniforms.pdf" class="inline-block mt-2 text-stars-blue hover:underline">Download the packet</a>
    </section>
  </div>
</FamilyChrome>
