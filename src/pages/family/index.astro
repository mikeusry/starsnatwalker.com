---
import FamilyChrome from '../../components/FamilyChrome.astro';
import schedule from '../../data/schedule.json';
import notices from '../../data/family-notices.json';
import {
  upcomingEvents,
  nextEvent,
  typeLabel,
  locationLine,
  mapsUrl,
  type ScheduleEvent,
} from '../../lib/calendar';

const events = schedule.events as ScheduleEvent[];
const next = nextEvent(events, { family: true });
const upcoming = upcomingEvents(events, { family: true });
const pins = notices.slice(0, 3);

const utilities = [
  { href: '/family/schedule/', label: 'Schedule' },
  { href: '/family/travel/', label: 'Travel' },
  { href: '/family/uniforms/', label: 'Uniforms' },
  { href: '/family/roster/', label: 'Roster' },
  { href: '/family/recruiting/', label: 'Recruiting' },
];
---

<FamilyChrome title="Family" current="home">
  <div>
    <p class="text-[11px] font-bold uppercase tracking-wider text-stars-navy/70 mb-4">Family brief</p>

    <div class="grid gap-5 lg:grid-cols-5 lg:items-start">
      {next ? (
        <section class="lg:col-span-3 bg-stars-navy text-white rounded-xl p-4">
          <p class="text-xs font-semibold uppercase tracking-wider text-stars-gold">Next up</p>
          <p class="text-white/70 text-sm font-medium mt-2">
            {next.dates}
            <span class="text-white/40"> · </span>
            {typeLabel(next)}
          </p>
          <h1 class="text-xl font-bold leading-snug mt-1 line-clamp-2">{next.name}</h1>
          {locationLine(next) && (
            <p class="text-white/70 text-sm mt-1 line-clamp-1">{locationLine(next)}</p>
          )}
          <div class="flex flex-wrap gap-x-4 gap-y-1 mt-4 text-sm">
            <a href="/family/schedule/" class="text-stars-gold font-medium hover:underline">View schedule</a>
            <a href="/family/travel/" class="text-white/80 hover:text-white hover:underline">Travel notes</a>
            {mapsUrl(next) && (
              <a href={mapsUrl(next)!} target="_blank" rel="noopener noreferrer" class="text-white/80 hover:text-white hover:underline">Map</a>
            )}
          </div>
        </section>
      ) : (
        <section class="lg:col-span-3 rounded-xl p-4 border border-stars-navy/15">
          <p class="text-xs font-semibold uppercase tracking-wider text-stars-navy/70">Next up</p>
          <p class="text-stars-navy font-medium mt-2">No event currently posted.</p>
          <a href="/family/schedule/" class="inline-block mt-3 text-sm text-stars-blue hover:underline">Schedule</a>
        </section>
      )}

      <section class="lg:col-span-2">
        <h2 class="text-xs font-bold uppercase tracking-wider text-stars-navy/70 mb-3">Need to know</h2>
        {pins.length === 0 ? (
          <p class="text-sm text-stars-navy/60">Nothing pinned right now.</p>
        ) : (
          <ul class="space-y-2.5">
            {pins.map((notice) => (
              <li class="bg-white rounded-xl px-4 py-3 border border-stars-navy/10 border-l-4 border-l-stars-gold">
                <p class="text-xs text-stars-navy/50">{notice.date}</p>
                <h3 class="text-stars-navy font-semibold mt-0.5">{notice.title}</h3>
                <p class="text-sm text-stars-navy/80 mt-1 line-clamp-2">{notice.body}</p>
                {notice.href && (
                  <a href={notice.href} class="inline-block mt-2 text-sm text-stars-blue hover:underline">{notice.hrefLabel || 'Open'}</a>
                )}
              </li>
            ))}
          </ul>
        )}
      </section>
    </div>

    <section class="mt-6 bg-white rounded-xl border border-stars-navy/10 overflow-hidden">
      <div class="flex items-center justify-between gap-3 px-4 py-3 bg-stars-navy text-white">
        <h2 class="font-semibold">{schedule.season} schedule</h2>
        <a href="/family/schedule/" class="text-xs text-stars-gold hover:underline">Full schedule</a>
      </div>
      {upcoming.length === 0 ? (
        <p class="px-4 py-3 text-sm text-stars-navy/60">No upcoming events yet.</p>
      ) : (
        <ul class="divide-y divide-gray-100">
          {upcoming.map((event) => (
            <li class="px-4 py-3 flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="text-stars-navy font-medium">
                  {event.name}
                  <span class="ml-2 text-xs font-normal text-stars-navy/50">{typeLabel(event)}</span>
                </p>
                <p class="text-sm text-stars-navy/60 mt-0.5">{event.dates}{locationLine(event) && ` · ${locationLine(event)}`}</p>
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>

    <nav class="mt-6 text-sm text-stars-navy/70" aria-label="Family pages">
      {utilities.map((item, i) => (
        <>
          {i > 0 && <span class="mx-2 text-stars-silver">·</span>}
          <a href={item.href} class="hover:text-stars-navy hover:underline">{item.label}</a>
        </>
      ))}
    </nav>
  </div>
</FamilyChrome>
