---
import FamilyChrome from '../../components/FamilyChrome.astro';
import schedule from '../../data/schedule.json';
import travel from '../../data/family-travel.json';
import {
  upcomingEvents,
  nextEvent,
  typeLabel,
  locationLine,
  mapsUrl,
  googleTemplateUrl,
  eventPagePath,
  eventType,
  travelKitPath,
  hotelBadge,
  type ScheduleEvent,
} from '../../lib/calendar';

const events = schedule.events as ScheduleEvent[];
const upcoming = upcomingEvents(events, { family: true });
const next = nextEvent(events, { family: true });
const weekends = upcoming.filter((event) => eventType(event) !== 'camp');
const camps = upcoming.filter((event) => eventType(event) === 'camp');

const familyIcs = 'https://starsnatwalker.com/family/calendar.ics';
const webcal = familyIcs.replace('https://', 'webcal://');
const googleSubscribe = `https://calendar.google.com/calendar/render?cid=${encodeURIComponent(familyIcs)}`;
---

<FamilyChrome title="Schedule" current="schedule">
  <div class="space-y-5">
    {next && (
      <section class="bg-stars-navy text-white rounded-xl p-5 shadow-md">
        <p class="text-xs font-semibold uppercase tracking-wider text-stars-gold">Next up</p>
        <h2 class="text-xl font-semibold mt-1">{next.name}</h2>
        <p class="text-white/70 text-sm mt-1">{next.dates}{locationLine(next) && ` · ${locationLine(next)}`}</p>
        {next.notes && <p class="text-white/80 text-sm mt-3">{next.notes}</p>}
        <div class="flex flex-wrap gap-3 mt-4 text-sm">
          <a href={googleTemplateUrl(next)} target="_blank" rel="noopener noreferrer" class="text-stars-gold hover:underline">Add to calendar</a>
          {mapsUrl(next) && (
            <a href={mapsUrl(next)!} target="_blank" rel="noopener noreferrer" class="text-white/80 hover:text-white hover:underline">Map</a>
          )}
          {eventPagePath(next) && (
            <a href={eventPagePath(next)!} class="text-white/80 hover:text-white hover:underline">Event page</a>
          )}
          {travelKitPath(next) && (
            <a href={travelKitPath(next)!} class="text-white/80 hover:text-white hover:underline">Weekend kit</a>
          )}
        </div>
      </section>
    )}

    <section class="bg-white rounded-xl shadow-md p-5">
      <h2 class="text-stars-navy font-semibold mb-2">The rules</h2>
      <ul class="text-sm text-gray-700 space-y-1.5">
        {travel.rules.map((rule) => (
          <li class="flex gap-2"><span class="text-stars-gold">●</span> {rule}</li>
        ))}
      </ul>
    </section>

    <section class="space-y-3">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <h2 class="text-stars-navy font-semibold">Weekends</h2>
        <p class="text-xs text-gray-500">
          <a href={webcal} class="text-stars-navy hover:underline">Apple</a>
          <span class="mx-1.5 text-gray-300">·</span>
          <a href={googleSubscribe} target="_blank" rel="noopener noreferrer" class="text-stars-navy hover:underline">Google</a>
          <span class="mx-1.5 text-gray-300">·</span>
          <a href="/family/calendar.ics" class="text-stars-navy hover:underline">Outlook</a>
        </p>
      </div>
      {weekends.map((event) => {
        const badge = hotelBadge(event);
        const href = travelKitPath(event);
        return (
          <article class="bg-white rounded-xl shadow-md p-5 border-l-4 border-stars-gold">
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div>
                <p class="text-stars-navy font-semibold">{event.name}</p>
                <p class="text-sm text-gray-500 mt-0.5">
                  {event.dates}
                  {locationLine(event) && ` · ${locationLine(event)}`}
                  <span class="ml-2 text-xs text-gray-400">{typeLabel(event)}</span>
                </p>
              </div>
              <span class:list={['text-xs font-semibold uppercase tracking-wider px-2 py-1 rounded', badge === 'posted' ? 'bg-stars-navy text-stars-gold' : 'bg-gray-100 text-gray-500']}>
                {badge === 'posted' ? 'Hotel posted' : badge === 'none' ? 'No hotel' : 'Hotel not posted yet'}
              </span>
            </div>
            {event.notes && <p class="text-sm text-gray-700 mt-2">{event.notes}</p>}
            <div class="mt-4 flex flex-col gap-2">
              {href && (
                <a href={href} class="block text-center bg-stars-navy text-white font-semibold text-sm px-4 py-3 rounded-lg">Open weekend kit</a>
              )}
              <a href={googleTemplateUrl(event)} target="_blank" rel="noopener noreferrer" class="block text-center text-sm text-stars-blue hover:underline">Add to calendar</a>
            </div>
          </article>
        );
      })}
    </section>

    {camps.length > 0 && (
      <section class="space-y-3">
        <h2 class="text-stars-navy font-semibold">One-day</h2>
        {camps.map((event) => {
          const badge = hotelBadge(event);
          const href = travelKitPath(event);
          return (
            <article class="bg-white rounded-xl shadow-md p-5 border-l-4 border-stars-gold">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <div>
                  <p class="text-stars-navy font-semibold">{event.name}</p>
                  <p class="text-sm text-gray-500 mt-0.5">
                    {event.dates}
                    {locationLine(event) && ` · ${locationLine(event)}`}
                    <span class="ml-2 text-xs text-gray-400">{typeLabel(event)}</span>
                  </p>
                </div>
                <span class:list={['text-xs font-semibold uppercase tracking-wider px-2 py-1 rounded', badge === 'posted' ? 'bg-stars-navy text-stars-gold' : 'bg-gray-100 text-gray-500']}>
                  {badge === 'posted' ? 'Hotel posted' : badge === 'none' ? 'No hotel' : 'Hotel not posted yet'}
                </span>
              </div>
              {event.notes && <p class="text-sm text-gray-700 mt-2">{event.notes}</p>}
              <div class="mt-4 flex flex-col gap-2">
                {href && (
                  <a href={href} class="block text-center bg-stars-navy text-white font-semibold text-sm px-4 py-3 rounded-lg">Open weekend kit</a>
                )}
                <a href={googleTemplateUrl(event)} target="_blank" rel="noopener noreferrer" class="block text-center text-sm text-stars-blue hover:underline">Add to calendar</a>
              </div>
            </article>
          );
        })}
      </section>
    )}

    <figure class="bg-white rounded-xl shadow-md overflow-hidden">
      <img src={travel.graphic} alt="Stars National Walker 2026 Fall Tournament Schedule — 6 tournaments plus Elon team camp" class="w-full" />
      <figcaption class="px-4 py-2 text-xs text-gray-500">Pinned graphic. Dates listed are game days.</figcaption>
    </figure>
  </div>
</FamilyChrome>
