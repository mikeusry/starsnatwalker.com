---
import FamilyChrome from '../../components/FamilyChrome.astro';
import schedule from '../../data/schedule.json';
import travel from '../../data/family-travel.json';
import {
  upcomingEvents,
  typeLabel,
  locationLine,
  hasTeamHotel,
  travelKitPath,
  eventType,
  type ScheduleEvent,
} from '../../lib/calendar';

const upcoming = upcomingEvents(schedule.events as ScheduleEvent[], { family: true });
const weekends = upcoming.filter((event) => eventType(event) !== 'camp');
const camps = upcoming.filter((event) => eventType(event) === 'camp');
---

<FamilyChrome title="Travel" current="travel">
  <div class="space-y-5">
    <div>
      <p class="text-xs text-gray-500">Updated {travel.updated}</p>
      <h1 class="text-2xl font-semibold text-stars-navy mt-1">{travel.headline}</h1>
      <p class="text-sm text-gray-600 mt-1">One page per weekend. Hotels, the ballpark, when to be there.</p>
    </div>

    <section class="bg-white rounded-xl shadow-md p-5">
      <h2 class="text-stars-navy font-semibold mb-2">The rules</h2>
      <ul class="text-sm text-gray-700 space-y-1.5">
        {travel.rules.map((rule) => (
          <li class="flex gap-2"><span class="text-stars-gold">●</span> {rule}</li>
        ))}
      </ul>
    </section>

    <figure class="bg-white rounded-xl shadow-md overflow-hidden">
      <img src={travel.graphic} alt="Stars National Walker 2026 Fall Tournament Schedule — 6 tournaments plus Elon team camp" class="w-full" />
      <figcaption class="px-4 py-2 text-xs text-gray-500">Pinned graphic. Dates listed are game days.</figcaption>
    </figure>

    <section class="space-y-3">
      <h2 class="text-stars-navy font-semibold">Weekends</h2>
      {weekends.map((event) => {
        const ready = hasTeamHotel(event);
        const href = ready ? travelKitPath(event) : null;
        return (
          <article class="bg-white rounded-xl shadow-md p-5 border-l-4 border-stars-gold">
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div>
                <p class="text-stars-navy font-semibold">{event.name}</p>
                <p class="text-sm text-gray-500 mt-0.5">
                  {event.dates}
                  {locationLine(event) && ` · ${locationLine(event)}`}
                  <span class="ml-2 text-xs text-gray-400">{typeLabel(event)}</span>
                </p>
              </div>
              <span class:list={['text-xs font-semibold uppercase tracking-wider px-2 py-1 rounded', ready ? 'bg-stars-navy text-stars-gold' : 'bg-gray-100 text-gray-500']}>
                {ready ? 'Kit ready' : 'Hotel not posted yet'}
              </span>
            </div>
            {event.notes && <p class="text-sm text-gray-700 mt-2">{event.notes}</p>}
            {href ? (
              <a href={href} class="inline-block mt-3 text-sm font-medium text-stars-navy underline">Open weekend kit</a>
            ) : (
              <p class="text-sm text-gray-500 mt-3">Kit opens when the team hotel block is posted.</p>
            )}
          </article>
        );
      })}
    </section>

    {camps.length > 0 && (
      <section class="bg-white rounded-xl shadow-md p-5">
        <h2 class="text-stars-navy font-semibold mb-2">One-day</h2>
        {camps.map((event) => (
          <article>
            <p class="text-stars-navy font-medium">{event.name}</p>
            <p class="text-sm text-gray-500">{event.dates}{locationLine(event) && ` · ${locationLine(event)}`}</p>
            {event.notes && <p class="text-sm text-gray-700 mt-2">{event.notes}</p>}
          </article>
        ))}
      </section>
    )}
  </div>
</FamilyChrome>
