---
// Top Gun National Walker hero (Design Desk spec, Oct 2026).
// Navy background with the team photo at 35% opacity, orange eyebrow,
// rename announcement, and a link to the roster.
const teamPhoto = '/team.webp';
---

<!-- Rename banner directly under the fixed 72px header -->
<div class="mt-[72px] bg-tg-sky border-b border-tg-line">
  <div class="container-narrow py-2 text-center text-sm text-tg-navy">
    <span class="font-semibold">Top Gun National Walker</span> &middot; Formerly Stars National Walker.
  </div>
</div>

<section class="relative bg-tg-navy overflow-hidden">
  <img
    src={teamPhoto}
    alt=""
    aria-hidden="true"
    width="1920"
    height="1440"
    class="absolute inset-0 w-full h-full object-cover opacity-35"
    fetchpriority="high"
    loading="eager"
  />
  <div class="absolute inset-0 bg-tg-navy/70"></div>

  <div class="container-narrow relative z-10 py-20 md:py-28">
    <div class="max-w-2xl text-center md:text-left">
      <span class="tg-eyebrow mb-4">New Name</span>

      <h1 class="text-white mb-5 text-[32px] md:text-[44px]">
        Stars National Walker is now Top Gun National Walker.
      </h1>

      <p class="text-lg md:text-xl text-white/85 mb-8">
        We're proud to join the
        <a href="https://topgunfastpitch.com" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 decoration-white/50 hover:text-tg-orange hover:decoration-tg-orange">Top Gun Fastpitch</a>
        family. Our history comes with us.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
        <a href="#roster" class="inline-flex items-center justify-center px-7 py-3 rounded-full bg-white text-tg-navy font-semibold hover:bg-tg-sky transition-colors">
          View Roster
        </a>
        <a href="#about" class="inline-flex items-center justify-center px-7 py-3 rounded-full border-2 border-white text-white font-semibold hover:bg-white hover:text-tg-navy transition-colors">
          About the team
        </a>
      </div>
    </div>
  </div>
</section>
