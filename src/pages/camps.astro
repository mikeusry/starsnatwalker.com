---
// Family camp check-in. Write-only by design: a family submits and sees
// nothing else. Some players do not want other families seeing where they are
// going, so there is deliberately no list view behind this gate.
import Layout from '../layouts/Layout.astro';
import playersData from '../data/players.json';

const raw: any = playersData;
const players = (Array.isArray(raw) ? raw : raw.players || [])
  .map((p: any) => `${p.firstName ?? ''} ${p.lastName ?? ''}`.trim())
  .filter(Boolean)
  .sort((a: string, b: string) => a.localeCompare(b));
---

<Layout title="Camp Check-In | Stars National Walker" noindex={true}>
  <!-- Login gate -->
  <div id="gate" class="min-h-screen flex items-center justify-center bg-stars-navy py-12 px-4">
    <div class="max-w-md w-full">
      <div class="text-center mb-8">
        <img src="/logo.webp" alt="Stars National Walker" class="h-20 mx-auto mb-4" />
        <h1 class="text-2xl font-bold text-white">Camp Check-In</h1>
        <p class="text-white/70 text-sm mt-2">Let the coaches know where you're going.</p>
      </div>

      <form id="gate-form" class="bg-white rounded-xl shadow-2xl p-8">
        <label for="gate-pass" class="block text-sm font-medium text-gray-700 mb-2">
          Team Password
        </label>
        <input
          type="password"
          id="gate-pass"
          required
          autocomplete="current-password"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-stars-red focus:border-transparent"
          placeholder="Enter team password"
        />
        <div id="gate-error" class="hidden text-red-600 text-sm text-center mt-4"></div>
        <button
          type="submit"
          class="mt-6 w-full bg-stars-red hover:bg-red-700 text-white font-bold py-3 px-4 rounded-lg transition-colors"
        >
          Continue
        </button>
      </form>

      <p class="text-center text-white/50 text-sm mt-6">
        <a href="/" class="hover:text-white transition-colors">&larr; Back to site</a>
      </p>
    </div>
  </div>

  <!-- Form -->
  <div id="app" class="hidden min-h-screen bg-gray-50 py-12 px-4">
    <div class="max-w-xl mx-auto">
      <div class="text-center mb-8">
        <img src="/logo.webp" alt="Stars National Walker" class="h-16 mx-auto mb-4" />
        <h1 class="text-3xl font-bold text-stars-navy">Camp Check-In</h1>
        <p class="text-gray-600 mt-2">
          Tell us which camps you're going to so the coaches can reach out to those
          college staffs for you.
        </p>
      </div>

      <div id="success" class="hidden bg-green-50 border border-green-300 rounded-xl p-6 mb-6 text-center">
        <p class="text-green-800 font-semibold">Got it — thanks!</p>
        <p class="text-green-700 text-sm mt-1">The coaches can see it now.</p>
        <button id="again" class="mt-4 text-stars-red font-semibold hover:underline">
          Add another camp
        </button>
      </div>

      <form id="camp-form" class="bg-white rounded-2xl shadow-xl p-8 space-y-6">
        <div>
          <label for="playerName" class="block text-sm font-medium text-gray-700 mb-2">
            Player <span class="text-stars-red">*</span>
          </label>
          <select
            id="playerName"
            name="playerName"
            required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-stars-red focus:border-transparent bg-white"
          >
            <option value="">Choose a player…</option>
            {players.map((n: string) => <option value={n}>{n}</option>)}
          </select>
        </div>

        <div>
          <label for="campName" class="block text-sm font-medium text-gray-700 mb-2">
            Camp / College <span class="text-stars-red">*</span>
          </label>
          <input
            type="text"
            id="campName"
            name="campName"
            required
            list="camp-suggestions"
            placeholder="e.g. Liberty Prospect Camp"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-stars-red focus:border-transparent"
          />
          <datalist id="camp-suggestions"></datalist>
          <p class="text-xs text-gray-500 mt-1">
            Start typing — pick a suggestion or type your own.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="campDate" class="block text-sm font-medium text-gray-700 mb-2">
              Date <span class="text-stars-red">*</span>
            </label>
            <input
              type="date"
              id="campDate"
              name="campDate"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-stars-red focus:border-transparent"
            />
          </div>
          <div>
            <label for="status" class="block text-sm font-medium text-gray-700 mb-2">
              Status
            </label>
            <select
              id="status"
              name="status"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-stars-red focus:border-transparent bg-white"
            >
              <option value="registered">Registered / signed up</option>
              <option value="considering">Thinking about it</option>
              <option value="attending">Going</option>
              <option value="attended">Already went</option>
            </select>
          </div>
        </div>

        <div>
          <label for="notes" class="block text-sm font-medium text-gray-700 mb-2">
            Anything else?
          </label>
          <textarea
            id="notes"
            name="notes"
            rows="3"
            placeholder="Which coaches you're hoping to see, questions, etc."
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-stars-red focus:border-transparent"
          ></textarea>
        </div>

        <div id="form-error" class="hidden text-red-600 text-sm text-center"></div>

        <button
          id="submitBtn"
          type="submit"
          class="w-full bg-stars-red hover:bg-red-700 text-white font-bold py-3 px-4 rounded-lg transition-colors"
        >
          Submit
        </button>
      </form>

      <p class="text-center text-gray-400 text-xs mt-6">
        Only the coaching staff sees these. Other families do not.
      </p>
    </div>
  </div>

  <script is:inline>
    (function () {
      var PASS = 'stars27';
      var KEY = 'snw_camp_auth';
      var gate = document.getElementById('gate');
      var app = document.getElementById('app');

      function unlock() {
        gate.classList.add('hidden');
        app.classList.remove('hidden');
      }
      if (sessionStorage.getItem(KEY) === 'true') unlock();

      document.getElementById('gate-form').addEventListener('submit', function (e) {
        e.preventDefault();
        var v = document.getElementById('gate-pass').value.trim();
        var err = document.getElementById('gate-error');
        if (v.toLowerCase() === PASS) {
          sessionStorage.setItem(KEY, 'true');
          unlock();
        } else {
          err.textContent = 'That password is not right.';
          err.classList.remove('hidden');
        }
      });

      var form = document.getElementById('camp-form');
      var ok = document.getElementById('success');
      var err = document.getElementById('form-error');
      var btn = document.getElementById('submitBtn');

      document.getElementById('again').addEventListener('click', function () {
        ok.classList.add('hidden');
        form.classList.remove('hidden');
      });

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        err.classList.add('hidden');
        btn.disabled = true;
        btn.textContent = 'Submitting…';

        var payload = {
          playerName: document.getElementById('playerName').value,
          campName: document.getElementById('campName').value,
          campDate: document.getElementById('campDate').value,
          status: document.getElementById('status').value,
          notes: document.getElementById('notes').value,
        };

        try {
          var res = await fetch('/api/camp-checkin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          var body = await res.json().catch(function () {
            return {};
          });
          if (!res.ok) throw new Error(body.error || 'Could not save.');

          form.reset();
          form.classList.add('hidden');
          ok.classList.remove('hidden');
          ok.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } catch (e2) {
          // Surface the real reason — a silent failure here means a camp
          // nobody knows about, which is the exact problem this form exists
          // to solve.
          err.textContent = e2.message || 'Could not save. Please tell Mike.';
          err.classList.remove('hidden');
        } finally {
          btn.disabled = false;
          btn.textContent = 'Submit';
        }
      });
    })();
  </script>
</Layout>
